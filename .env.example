# Bhasha Shiksha Setu — Backend Environment Configuration
# Copy this file to .env and replace the placeholder values.
# NEVER commit .env to GitHub.

# Core
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DEBUG=false

# Database
# Local development:
DATABASE_URL=sqlite:///bhasha_shiksha_setu.db
# Production (Render PostgreSQL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# AI / Translation
# demo = offline/demo mode; openai = OpenAI-compatible API
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

TRANSLATION_PROVIDER=demo

# Voice
TTS_PROVIDER=browser
TTS_URL=
TTS_API_KEY=
STT_URL=
STT_API_KEY=

# Frontend access
# Replace with your deployed frontend URL in production.
CORS_ORIGINS=http://localhost:5500

# Authentication
TOKEN_EXPIRY_HOURS=24

# Uploads
MAX_UPLOAD_MB=50

# Admin seed values
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@bhasha.setu
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# Demo data
SEED_DEMO=true

# Server
PORT=5000

